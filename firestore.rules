rules_version = '2';

// Reglas de DESARROLLO de Barra.
//
// Objetivo: que la app funcione mientras pruebas, SIN que caduquen (el "modo
// de prueba" de Firestore caduca a los ~30 días y luego bloquea todo).
//
// `cafe_payments` NO aparece aquí a propósito: las colecciones sin regla
// quedan denegadas por defecto, así que los tokens de Mercado Pago solo los
// toca el backend (Admin SDK, que ignora estas reglas). No lo agregues.
//
// ⚠️ ANTES DE PRODUCCIÓN hay que endurecer esto (validar request.auth,
//    que cada café solo vea lo suyo, etc.).
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read, write: if true;
    }
    match /cafes/{cafeId} {
      allow read, write: if true;
      match /products/{productId} {
        allow read, write: if true;
      }
    }
    match /orders/{orderId} {
      allow read, write: if true;
    }
    match /staff/{uid} {
      allow read, write: if true;
    }
    match /attendance/{id} {
      allow read, write: if true;
    }
    // cafe_payments: sin regla → acceso denegado a clientes (solo backend).
  }
}
