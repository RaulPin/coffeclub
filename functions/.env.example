# Configuración del backend de pagos (Mercado Pago).
#
# Valores NO secretos → parámetros (se piden al desplegar o van en .env local):
MP_CLIENT_ID=0000000000000000
MP_REDIRECT_URI=https://us-central1-barra-77b43.cloudfunctions.net/mpOAuthCallback
APP_RETURN_URL=https://barra-77b43.web.app

# Valores SECRETOS → NO van aquí ni en git. Se cargan con:
#   firebase functions:secrets:set MP_CLIENT_SECRET
#   firebase functions:secrets:set MP_ACCESS_TOKEN
#
# (MP_CLIENT_SECRET y MP_ACCESS_TOKEN salen del panel de desarrolladores
#  de Mercado Pago → tu aplicación → Credenciales de producción.)
#
# Solo para el emulador local puedes ponerlos temporalmente en un .env:
# MP_CLIENT_SECRET=xxxxxxxxxxxxxxxx
# MP_ACCESS_TOKEN=APP_USR-xxxxxxxx
