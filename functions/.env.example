# Copia a `.env` para el emulador local (NO subir .env a git).
# En producción, usa secretos de Firebase para las llaves de Stripe:
#   firebase functions:secrets:set STRIPE_SECRET_KEY
#   firebase functions:secrets:set STRIPE_WEBHOOK_SECRET
#
# El price ID de la suscripción no es secreto y puede ir como parámetro:
STRIPE_SUBSCRIPTION_PRICE=price_XXXXXXXXXXXX

# Solo para el emulador local:
# STRIPE_SECRET_KEY=sk_test_XXXX
# STRIPE_WEBHOOK_SECRET=whsec_XXXX
