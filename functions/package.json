    "logs": "firebase functions:log"
  },
  "dependencies": {
    "firebase-admin": "^12.6.0",
    "firebase-functions": "^6.1.0",
    "stripe": "^17.3.0"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  },
  "private": true
}
