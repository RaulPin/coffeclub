{
  "name": "coffeclub-functions",
  "description": "Cloud Functions para The Club Coffe (pagos, casilleros, turnos)",
  "engines": {
    "node": "20"
  },
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
